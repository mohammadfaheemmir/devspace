# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: error monitoring with Sentry (https://sentry.io). Leave empty to
# turn it off; the Sentry SDK is then not included at all.
VITE_SENTRY_DSN=
